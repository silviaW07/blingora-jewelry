# 1688 采集器配置
# 复制到 secrets/collector.env（该目录已被 git 忽略）
#
# INGEST_TOKEN 必须和服务器 .env 里的同名变量完全一致。
# 生成一个随机值：  openssl rand -hex 24
#
# 服务器 .env 还需：
#   INGEST_ALLOW_IPS=<采集机公网IP>   # 强烈建议；逗号分隔。未配置时仅 Token+限流
#   INGEST_RATE_LIMIT=60             # 可选，默认每分钟 60 次/IP

INGEST_TOKEN=在这里粘贴服务器上的同一个token

# 后台地址，通常不用改
COLLECTOR_SERVER=https://sourcingjewelry.com
