  minWeightKg       Decimal?           @db.Decimal(10, 3)
  maxWeightKg       Decimal?           @db.Decimal(10, 3)
  minOrderAmount    Decimal?           @db.Decimal(10, 2)
  maxOrderAmount    Decimal?           @db.Decimal(10, 2)
  shippingFee       Decimal            @db.Decimal(10, 2)
