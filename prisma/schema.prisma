model product_category_relations {
  id         String   @id @default(uuid()) @db.VarChar(36)
  productId  String   @db.VarChar(36)
  categoryId String   @db.VarChar(36)
  /** 类目内优先展示权重；0 表示不置顶，沿用前台原排序 */
  sortWeight Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt @default(now())

  product    product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category   category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([productId, categoryId])
  @@index([productId])
  @@index([categoryId])
  @@index([categoryId, sortWeight])
}

model product_keyword_relations {
  id         String      @id @default(uuid()) @db.VarChar(36)
  productId  String      @db.VarChar(36)
  keywordId  String      @db.VarChar(36)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt @default(now())

  product    product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  keyword    keyworditem @relation(fields: [keywordId], references: [id], onDelete: Cascade)

  @@unique([productId, keywordId])
  @@index([productId])
  @@index([keywordId])
}

model keywordgroupproduct {
  id             String       @id @default(uuid()) @db.VarChar(36)
  keywordGroupId String       @db.VarChar(36)
  productId      String       @db.VarChar(36)
  sortWeight     Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt @default(now())

  keywordGroup   keywordgroup @relation(fields: [keywordGroupId], references: [id])
  product        product      @relation(fields: [productId], references: [id])

  @@unique([keywordGroupId, productId])
  @@index([keywordGroupId])
  @@index([productId])
  @@index([sortWeight])
}

/// 商品标题后缀预设（“批量加后缀”下拉框数据源，支持自定义 CRUD）
model suffixconfig {
  id         String   @id @default(uuid()) @db.VarChar(36)
  suffixName String   @unique @map("suffix_name") @db.VarChar(120)
  sortWeight Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt @default(now())

  @@index([sortWeight])
  @@map("suffix_config")
}

/// 品牌别名归一：采集/翻译/上架前把卖家暗语（如“蔻C/蔻家/古驰/LV”）替换成标准品牌名，支持后台 CRUD
model brandalias {
  id           String   @id @default(uuid()) @db.VarChar(36)
  alias        String   @unique @db.VarChar(120)
  standardName String   @map("standard_name") @db.VarChar(120)
  sortWeight   Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt @default(now())

  @@index([sortWeight])
  @@map("brand_alias")
}

enum buyershowmediatype {
  IMAGE
  VIDEO
}

enum buyershowcommentstatus {
  PENDING
  APPROVED
  REJECTED
}

/// 买家秀媒体：后台上传图片/视频，可选标题；前台独立页展示
model buyershowmedia {
  id         String             @id @default(uuid()) @db.VarChar(36)
  mediaType  buyershowmediatype @map("media_type")
  mediaUrl   String             @map("media_url") @db.VarChar(700)
  title      String?            @db.VarChar(160)
  sortWeight Int                @default(0) @map("sort_weight")
  isEnabled  Boolean            @default(true) @map("is_enabled")
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt @default(now())

  @@index([isEnabled, sortWeight])
  @@map("buyer_show_media")
}

/// 买家秀留言：客户提交后待审核，通过后才在前台展示
model buyershowcomment {
  id         String                  @id @default(uuid()) @db.VarChar(36)
  authorName String                  @map("author_name") @db.VarChar(80)
  content    String                  @db.Text
  rating     Int?                    // 1-5 评价打分，纯留言可为空
  status     buyershowcommentstatus  @default(PENDING)
  createdAt  DateTime                @default(now())
  reviewedAt DateTime?               @map("reviewed_at")

  @@index([status, createdAt])
  @@map("buyer_show_comment")
}
