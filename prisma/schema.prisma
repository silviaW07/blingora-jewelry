  isActive          Boolean            @default(true)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt @default(now())
}

/// 物流渠道配置：名称、时效、计费模式、渠道系数、按国家运费规则、启用状态
model shippingchannel {
  id                  String   @id @default(uuid()) @db.VarChar(36)
  name                String   @db.VarChar(120)
  estimatedTime       String   @db.VarChar(120)
  /// 计费模式：EXPRESS_TIER（快递阶梯价）| SEA_PER_KG（海运按公斤）
  billingMode         String   @default("EXPRESS_TIER") @db.VarChar(30)
  /// 渠道系数，最终运费 = 基础运费 × 系数，默认 1.00
  channelCoefficient  Decimal  @default(1.0000) @db.Decimal(10, 4)
  /// 按国家运费规则（人民币 ¥）。
  /// EXPRESS_TIER: { "United States": { "tiers": [{ "maxKg": 0.5, "fee": 10 }] } }
  /// SEA_PER_KG:   { "United States": { "baseKg": 12, "baseFee": 180, "perKgFee": 12 } }
  /// 兼容旧版固定价数字：{ "United States": 15.53 }
  countryFeesJson     Json
  isEnabled           Boolean  @default(true)
  sortWeight          Int      @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt @default(now())

  @@index([isEnabled])
  @@index([sortWeight])
  @@index([billingMode])
}

