}

model orderrecord {
  id                String             @id @default(uuid()) @db.VarChar(36)
  orderNo           String             @unique @db.VarChar(60)
  userId            String             @db.VarChar(36)
  addressId         String?            @db.VarChar(36)
  status            orderstatus        @default(PENDING_PAYMENT)
  currencyCode      String             @db.VarChar(10)
  localeCode        String?            @db.VarChar(20)
  subtotalAmount    Decimal            @db.Decimal(10, 2)
  discountAmount    Decimal            @db.Decimal(10, 2) @default(0)
  shippingAmount    Decimal            @db.Decimal(10, 2) @default(0)
  giftWrapAmount    Decimal            @db.Decimal(10, 2) @default(0)
  totalAmount       Decimal            @db.Decimal(10, 2)
  paymentMethod     paymentmethodtype
  paymentStatus     String?            @db.VarChar(50)
  installmentInfo   String?            @db.VarChar(100)
  couponId          String?            @db.VarChar(36)
  shipMethod        ordershipmethod    @default(STANDARD)
  trackingCarrier   String?            @db.VarChar(255)
  trackingNumber    String?            @db.VarChar(100)
  estimatedArrivalAt DateTime?
  shippedAt         DateTime?
  internalNote      String?            @db.Text
  giftMessage       String?            @db.VarChar(255)
  note              String?            @db.Text
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt @default(now())

  user              sysuser            @relation(fields: [userId], references: [id])
  address           useraddress?       @relation(fields: [addressId], references: [id])
  coupon            promotioncampaign? @relation(fields: [couponId], references: [id])
