model keywordgroup {
  id                String             @id @default(uuid()) @db.VarChar(36)
  name              String             @db.VarChar(120)
  slug              String?            @db.VarChar(120)
  groupType         keywordgrouptype   @default(GENERAL)
  parentGroupId     String?            @db.VarChar(36)
  sceneKey          String?            @db.VarChar(160)
  sceneType         String?            @db.VarChar(80)
  sceneArea         keywordscenearea   @default(RECOMMENDATION)
  sceneSlotKey      String?            @db.VarChar(160)
  sceneSlotName     String?            @db.VarChar(120)
  floorTitle        String?            @db.VarChar(160)
  floorIcon         String?            @db.VarChar(160)
  floorLink         String?            @db.VarChar(255)
  homepageSortWeight Int               @default(0)
  showOnHomepage    Boolean            @default(false)
  sortWeight        Int                @default(0)
  isActive          Boolean            @default(true)
  description       String?            @db.Text
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt @default(now())

  parentGroup       keywordgroup?      @relation("KeywordGroupTree", fields: [parentGroupId], references: [id])
  childrenGroups    keywordgroup[]     @relation("KeywordGroupTree")
  keywords          keyworditem[]
  categoryLinks     categorykeywordlink[]
  productLinks      keywordgroupproduct[]

  @@index([groupType])
  @@index([parentGroupId])
  @@index([sceneKey])
  @@index([sceneType])
  @@index([sceneArea])
  @@index([sceneSlotKey])
  @@index([showOnHomepage])
  @@index([homepageSortWeight])
  @@index([isActive])
}

model keyworditem {
