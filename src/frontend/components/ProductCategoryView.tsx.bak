'use client'

import React from 'react'
import { Button } from '@/components/ui/button'
import { Input } from '@/components/ui/input'
import { Checkbox } from '@/components/ui/checkbox'
import { Switch } from '@/components/ui/switch'
import { Select, SelectTrigger, SelectValue, SelectContent, SelectItem } from '@/components/ui/select'
import { Label } from '@/components/ui/label'
import type { ProductCategoryState, ProductCategoryHandlers } from '@/frontend/hooks/useProductCategory'
import type { StockStatusEnum, SortByEnum } from '@/frontend/actions/ProductCategory'

interface Props {
  state: ProductCategoryState
  handlers: ProductCategoryHandlers
}

export const ProductCategoryView = ({ state, handlers }: Props) => {
  const {
    queryState,
    priceInput,
    categories,
    categoryDetail,
    products,
    totalCount,
    isLoadingCategories,
    isLoadingProducts,
    totalPages,
    stockStatusLabels,
    sortByLabels
  } = state

  return (
    <main>
      {/* 1. Hero Section (分类标题与说明) */}
      <header>
        {categoryDetail ? (
          <div>
            <h1>{categoryDetail.category_name}</h1>
            {categoryDetail.category_description && <p>{categoryDetail.category_description}</p>}
            <p>Displaying {categoryDetail.product_count} Verified Products</p>
          </div>
        ) : (
          <div>
            <h1>Global Industrial Equipment & Components</h1>
            <p>
              Engineered for precision. Sourced globally for enterprise-grade reliability and seamless
              integration into high-demand workflows.
            </p>
            <p>Displaying {totalCount} Verified Products</p>
          </div>
        )}
      </header>

      <div>
        {/* 2. 主体左侧：高密度筛选模块 */}
        <aside>
          <div>
            <h2>Filters</h2>
            <Button variant="ghost" onClick={handlers.handleClearAllFilters}>
              Clear All
            </Button>
          </div>

          <section>
            <h3>Categories</h3>
            {isLoadingCategories ? (
              <p>Loading categories...</p>
            ) : categories.length === 0 ? (
              <p>No categories found.</p>
            ) : (
              <ul>
                <li>
                  <Button
                    variant={queryState.categoryId === '' ? 'default' : 'outline'}
                    onClick={() => handlers.handleFilterChange('categoryId', '')}
                  >
                    All Categories
                  </Button>
                </li>
                {categories.map((cat) => (
                  <li key={cat.category_id}>
                    <Button
                      variant={queryState.categoryId === cat.category_id ? 'default' : 'outline'}
                      onClick={() => handlers.handleFilterChange('categoryId', cat.category_id)}
                    >
                      {cat.category_name}
                    </Button>
                  </li>
                ))}
              </ul>
            )}
          </section>

          <section>
            <h3>Price Range</h3>
            <div>
              <Input
                type="number"
                placeholder="Min ($)"
                value={priceInput.min}
                onChange={(e) => handlers.handlePriceInputChange('min', e.target.value)}
              />
              <span>-</span>
              <Input
                type="number"
                placeholder="Max ($)"
                value={priceInput.max}
                onChange={(e) => handlers.handlePriceInputChange('max', e.target.value)}
              />
            </div>
            <Button onClick={handlers.handleApplyPriceRange}>Apply</Button>
          </section>

          <section>
            <h3>Stock Status</h3>
            <ul>
              {(Object.keys(stockStatusLabels) as StockStatusEnum[]).map((status) => (
                <li key={status}>
                  <Checkbox
                    id={`stock-${status}`}
                    checked={queryState.stockStatus.includes(status)}
                    onCheckedChange={(checked) => handlers.handleStockStatusToggle(status, !!checked)}
                  />
                  <Label htmlFor={`stock-${status}`}>{stockStatusLabels[status]}</Label>
                </li>
              ))}
            </ul>
          </section>

          <section>
            <h3>Other Filters</h3>
            <div>
              <Switch
                id="discount-switch"
                checked={queryState.hasDiscount}
                onCheckedChange={(val) => handlers.handleFilterChange('hasDiscount', val)}
              />
              <Label htmlFor="discount-switch">Only show items with discount</Label>
            </div>
            <div>
              <Label>Minimum Rating</Label>
              <Select
                value={queryState.minRating ? queryState.minRating.toString() : 'ALL'}
                onValueChange={handlers.handleRatingChange}
              >
                <SelectTrigger>
                  <SelectValue placeholder="Select Rating" />
                </SelectTrigger>
                <SelectContent>
                  <SelectItem value="ALL">All Ratings</SelectItem>
                  <SelectItem value="4">4 Stars & Up</SelectItem>
                  <SelectItem value="3">3 Stars & Up</SelectItem>
                </SelectContent>
              </Select>
            </div>
          </section>
        </aside>

        {/* 3. 主体右侧：排序与视图控制区 + 商品列表 */}
        <section>
          {/* 排序控制区 */}
          <header>
            <p>
              Showing {(queryState.page - 1) * queryState.pageSize + 1} -{' '}
              {Math.min(queryState.page * queryState.pageSize, totalCount)} of {totalCount} products
            </p>
            <Select
              value={queryState.sortBy}
              onValueChange={(val) => handlers.handleFilterChange('sortBy', val as SortByEnum)}
            >
              <SelectTrigger>
                <SelectValue placeholder="Sort By" />
              </SelectTrigger>
              <SelectContent>
                {(Object.entries(sortByLabels) as [SortByEnum, string][]).map(([val, label]) => (
                  <SelectItem key={val} value={val}>
                    {label}
                  </SelectItem>
                ))}
              </SelectContent>
            </Select>
          </header>

          {/* 商品网格区 */}
          <div>
            {isLoadingProducts ? (
              <p>Loading products...</p>
            ) : products.length === 0 ? (
              <section>
                <h2>No products found</h2>
                <p>Try adjusting your filters or category selection.</p>
                <Button onClick={handlers.handleClearAllFilters}>Clear All Filters</Button>
              </section>
            ) : (
              <ul>
                {products.map((item) => (
                  <li key={item.product_id}>
                    <article>
                      <div onClick={() => handlers.handleNavigateToDetail(item.product_id)}>
                        <img src={item.main_image_url} alt={item.product_name} />
                        {item.has_discount && <span>Discount</span>}
                        {item.stock_status === 'LOW_STOCK' && <span>Low Stock</span>}
                      </div>

                      <div>
                        <p>★ {item.rating_average.toFixed(1)} ({item.rating_count})</p>
                        <h3 onClick={() => handlers.handleNavigateToDetail(item.product_id)}>
                          {item.product_name}
                        </h3>
                        {item.short_description && <p>{item.short_description}</p>}
                      </div>

                      <div>
                        <div>
                          <strong>${item.price.toFixed(2)}</strong>
                          {item.has_discount && item.original_price && (
                            <del>${item.original_price.toFixed(2)}</del>
                          )}
                        </div>
                        <p>{stockStatusLabels[item.stock_status]}</p>
                      </div>

                      <Button
                        disabled={item.stock_status === 'OUT_OF_STOCK'}
                        onClick={() => handlers.handleAddToCart(item)}
                      >
                        {item.sku_count > 1 ? 'Select Options' : 'Add to Cart'}
                      </Button>
                    </article>
                  </li>
                ))}
              </ul>
            )}
          </div>

          {/* 分页控制区 */}
          {!isLoadingProducts && products.length > 0 && (
            <nav>
              <Button
                variant="outline"
                disabled={queryState.page <= 1}
                onClick={() => handlers.handleFilterChange('page', queryState.page - 1)}
              >
                Previous
              </Button>
              <span>
                Page {queryState.page} of {totalPages}
              </span>
              <Button
                variant="outline"
                disabled={queryState.page >= totalPages}
                onClick={() => handlers.handleFilterChange('page', queryState.page + 1)}
              >
                Next
              </Button>
            </nav>
          )}
        </section>
      </div>
    </main>
  )
}