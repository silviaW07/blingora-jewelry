'use client'

import React from 'react'
import { Button } from '@/components/ui/button'
import { Input } from '@/components/ui/input'
import {
  Card,
  CardContent,
  CardFooter,
  CardHeader,
  CardTitle,
} from '@/components/ui/card'
import {
  Dialog,
  DialogContent,
  DialogDescription,
  DialogFooter,
  DialogHeader,
  DialogTitle,
} from '@/components/ui/dialog'
import { Badge } from '@/components/ui/badge'
import type { CartState, CartHandlers } from '@/frontend/hooks/useCart'
import { useQuantityControl } from '@/frontend/hooks/useCart'

interface Props {
  state: CartState
  handlers: CartHandlers
}

/**
 * 局部受控数量输入组件
 */
const QuantityControl = ({ 
  initialValue, 
  max, 
  disabled, 
  onUpdate 
}: { 
  initialValue: number
  max: number
  disabled: boolean
  onUpdate: (val: number) => void 
}) => {
  const {
    val,
    handleMinus,
    handlePlus,
    handleChange,
    handleBlur,
    handleKeyDown,
    handleCompositionStart,
    handleCompositionEnd
  } = useQuantityControl(initialValue, max, onUpdate)

  return (
    <fieldset disabled={disabled}>
      <Button variant="outline" size="icon" onClick={handleMinus}>
        -
      </Button>
      <Input
        type="text"
        value={val}
        onChange={handleChange}
        onBlur={handleBlur}
        onKeyDown={handleKeyDown}
        onCompositionStart={handleCompositionStart}
        onCompositionEnd={handleCompositionEnd}
      />
      <Button variant="outline" size="icon" onClick={handlePlus}>
        +
      </Button>
    </fieldset>
  )
}

export const CartView = ({ state, handlers }: Props) => {
  return (
    <main>
      <header>
        <h1>Secure Checkout</h1>
        <p>Review your items and proceed to seamless payment.</p>
      </header>

      <section>
        {state.loading ? (
          <div>
            <p>正在加载购物车数据，请稍候...</p>
          </div>
        ) : state.isEmpty ? (
          <div>
            <p>您的购物车空空如也，去挑选喜欢的商品吧</p>
            <Button onClick={handlers.handleNavigateToDefault}>
              Continue Shopping
            </Button>
          </div>
        ) : (
          <div>
            {/* 购物车商品列表 */}
            <div>
              <header>
                <h2>Shopping Cart</h2>
                {state.hasInvalidItems && (
                  <Button variant="secondary" onClick={handlers.handleRemoveInvalid} disabled={state.actionLoading}>
                    Clear Invalid Items
                  </Button>
                )}
                <Button variant="destructive" onClick={() => handlers.setIsClearConfirmOpen(true)} disabled={state.actionLoading}>
                  Clear All
                </Button>
              </header>

              <div>
                {state.items.map(item => (
                  <Card key={item.cartItemId}>
                    <CardHeader>
                      <img src={item.mainImageUrl} alt={item.productName} />
                      <CardTitle>{item.productName}</CardTitle>
                      {item.status === 'INVALID' && (
                        <Badge variant="destructive">
                          {state.CART_ITEM_STATUS_LABELS[item.status]} - {item.invalidReason}
                        </Badge>
                      )}
                    </CardHeader>
                    <CardContent>
                      <dl>
                        {item.skuAttributes?.map((attr, idx) => (
                          <div key={idx}>
                            <dt>{attr.name}</dt>
                            <dd>{attr.value}</dd>
                          </div>
                        ))}
                      </dl>
                      <p>单价: {item.price}</p>
                      <p>小计: {item.subtotal}</p>
                      
                      <QuantityControl
                        initialValue={item.quantity}
                        max={item.stock}
                        disabled={state.actionLoading || item.status === 'INVALID'}
                        onUpdate={(val) => handlers.handleUpdateQuantity(item.cartItemId, val)}
                      />
                    </CardContent>
                    <CardFooter>
                      <Button variant="outline" onClick={() => handlers.handleRemoveItem(item.cartItemId)} disabled={state.actionLoading}>
                        Remove
                      </Button>
                    </CardFooter>
                  </Card>
                ))}
              </div>
            </div>

            {/* 价格汇总区 */}
            {state.summary && (
              <Card>
                <CardHeader>
                  <CardTitle>Order Summary</CardTitle>
                </CardHeader>
                <CardContent>
                  <p>Total Items Price: {state.summary.totalPrice}</p>
                  <p>Estimated Shipping: {state.summary.shippingFee}</p>
                  <p>Discount: {state.summary.discount}</p>
                  <p><strong>Final Amount: {state.summary.finalAmount}</strong></p>
                  <p><small>Taxes and additional fees may apply during checkout.</small></p>
                </CardContent>
                <CardFooter>
                  <Button disabled={state.actionLoading || state.isEmpty}>Proceed to Checkout</Button>
                  <Button variant="link" onClick={handlers.handleNavigateToDefault}>
                    Continue Shopping
                  </Button>
                </CardFooter>
              </Card>
            )}
          </div>
        )}
      </section>

      {/* 购物辅助推荐区 */}
      <section>
        <header>
          <h2>Continue Your Journey</h2>
        </header>
        <div>
          {state.recommended.length > 0 ? (
            state.recommended.map(prod => (
              <Card key={prod.productId}>
                <CardHeader>
                  <img src={prod.mainImageUrl} alt={prod.name} />
                  <CardTitle>{prod.name}</CardTitle>
                </CardHeader>
                <CardContent>
                  <p>Starts at {prod.priceMin}</p>
                  <p>Rating: {prod.ratingAverage} / 5</p>
                </CardContent>
              </Card>
            ))
          ) : (
            <p>当前暂无推荐商品</p>
          )}
        </div>
      </section>

      {/* 清空确认弹窗 */}
      <Dialog open={state.isClearConfirmOpen} onOpenChange={handlers.setIsClearConfirmOpen}>
        <DialogContent>
          <DialogHeader>
            <DialogTitle>清空购物车</DialogTitle>
            <DialogDescription>
              此操作将移除购物车内的所有商品，确认要清空吗？
            </DialogDescription>
          </DialogHeader>
          <DialogFooter>
            <Button variant="outline" onClick={() => handlers.setIsClearConfirmOpen(false)} disabled={state.actionLoading}>
              取消
            </Button>
            <Button variant="destructive" onClick={handlers.handleClearCart} disabled={state.actionLoading}>
              确认清空
            </Button>
          </DialogFooter>
        </DialogContent>
      </Dialog>
    </main>
  )
}