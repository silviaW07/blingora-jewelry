'use client'

import React, { useRef } from 'react'
import type { HomeRecommendZoneManagementState, HomeRecommendZoneManagementHandlers } from '@/backend/hooks/useHomeRecommendZoneManagement'
import {
  Table,
  TableBody,
  TableCell,
  TableHead,
  TableHeader,
  TableRow,
} from '@/components/ui/table'
import { Button } from '@/components/ui/button'
import { Input } from '@/components/ui/input'
import { Switch } from '@/components/ui/switch'
import { Label } from '@/components/ui/label'
import { RadioGroup, RadioGroupItem } from '@/components/ui/radio-group'
import { Checkbox } from '@/components/ui/checkbox'
import {
  Dialog,
  DialogContent,
  DialogHeader,
  DialogTitle,
  DialogFooter,
  DialogDescription,
} from '@/components/ui/dialog'
import {
  Sheet,
  SheetContent,
  SheetHeader,
  SheetTitle,
  SheetFooter,
} from '@/components/ui/sheet'
import {
  Select,
  SelectContent,
  SelectItem,
  SelectTrigger,
  SelectValue,
} from '@/components/ui/select'
import type { ZoneType } from '@/backend/actions/HomeRecommendZoneManagement'

interface Props {
  state: HomeRecommendZoneManagementState
  handlers: HomeRecommendZoneManagementHandlers
}

const ZONE_TYPE_LABELS: Record<ZoneType, string> = {
  PRODUCT: '商品专区',
  CATEGORY: '类目专区',
}

export const HomeRecommendZoneManagementView = ({ state, handlers }: Props) => {
  const isComposingRef = useRef(false)
  const totalPages = Math.ceil(state.total / state.pageSize)
  const modalTotalPages = Math.ceil(state.modalTotal / 10)

  // 计算选择器当前页全选状态
  const modalPageItems = state.drawerFormData.zoneType === 'PRODUCT' ? state.modalProducts : state.modalCategories
  const existingIdsInDrawer = state.drawerItems.map(i => i.entityId)
  const selectablePageItems = modalPageItems.filter(item => !existingIdsInDrawer.includes(item.id))
  const isAllModalSelected = selectablePageItems.length > 0 && selectablePageItems.every(item => state.modalSelectedItems.some(si => si.id === item.id))

  return (
    <div>
      {/* 顶栏控制区 */}
      <div>
        <h2>首页推荐专区管理</h2>
        <Button onClick={() => handlers.onOpenDrawer(null)}>新增专区</Button>
      </div>

      {/* 核心数据网格 */}
      <div>
        {state.loading && state.list.length === 0 ? (
          <p>列表加载中...</p>
        ) : state.list.length === 0 ? (
          <p>暂无数据</p>
        ) : (
          <Table>
            <TableHeader>
              <TableRow>
                <TableHead></TableHead>
                <TableHead>专区标题</TableHead>
                <TableHead>展示类型</TableHead>
                <TableHead>终端布局</TableHead>
                <TableHead>数据绑定</TableHead>
                <TableHead>权重</TableHead>
                <TableHead>状态</TableHead>
                <TableHead>操作</TableHead>
              </TableRow>
            </TableHeader>
            <TableBody>
              {state.list.map((row, index) => (
                <TableRow 
                  key={row.id}
                  draggable
                  onDragStart={() => handlers.onListDragStart(index)}
                  onDragEnter={() => handlers.onListDragEnter(index)}
                  onDragEnd={() => handlers.onListDragEnd()}
                  onDragOver={(e) => e.preventDefault()}
                >
                  <TableCell>
                    <span style={{ cursor: 'move' }}>☰</span>
                  </TableCell>
                  <TableCell>{row.title}</TableCell>
                  <TableCell>{ZONE_TYPE_LABELS[row.zoneType]}</TableCell>
                  <TableCell>
                    PC: {row.pcCols}列 | 移动: {row.mobileCols}列
                  </TableCell>
                  <TableCell>
                    {row.isBoundCollection ? '永久集合' : '自定义列表'}
                  </TableCell>
                  <TableCell>
                    <Input 
                      type="number" 
                      defaultValue={row.sortWeight} 
                      onBlur={(e) => handlers.onWeightBlur(row.id, Number(e.target.value))}
                    />
                  </TableCell>
                  <TableCell>
                    <Switch 
                      checked={row.isActive} 
                      onCheckedChange={() => handlers.onToggleStatus(row.id, row.isActive)} 
                    />
                  </TableCell>
                  <TableCell>
                    <Button variant="ghost" onClick={() => handlers.onOpenDrawer(row.id)}>编辑</Button>
                    <Button variant="ghost" onClick={() => handlers.onOpenDrawer(row.id, true)}>复制</Button>
                    <Button variant="destructive" onClick={() => handlers.onDeleteClick(row.id)}>删除</Button>
                  </TableCell>
                </TableRow>
              ))}
            </TableBody>
          </Table>
        )}
      </div>

      {/* 列表分页器 */}
      {state.total > 0 && (
        <div>
          <Button disabled={state.page <= 1} onClick={() => handlers.onPageChange(state.page - 1)}>上一页</Button>
          <span>第 {state.page} 页 / 共 {totalPages} 页 (总 {state.total} 条)</span>
          <Button disabled={state.page >= totalPages} onClick={() => handlers.onPageChange(state.page + 1)}>下一页</Button>
        </div>
      )}

      {/* 专区配置抽屉 */}
      <Sheet open={state.drawerOpen} onOpenChange={handlers.onCloseDrawer}>
        <SheetContent>
          <SheetHeader>
            <SheetTitle>{state.editingId ? '编辑推荐专区' : '新增推荐专区'}</SheetTitle>
          </SheetHeader>
          
          {state.drawerLoading ? (
            <p>加载中...</p>
          ) : (
            <div>
              <div>
                <Label>专区标题</Label>
                <Input 
                  value={state.drawerFormData.title} 
                  onChange={e => handlers.onDrawerFieldChange('title', e.target.value)} 
                  placeholder="输入专区标题"
                />
              </div>
              <div>
                <Label>展示类型</Label>
                <RadioGroup 
                  value={state.drawerFormData.zoneType} 
                  onValueChange={(val) => handlers.onDrawerFieldChange('zoneType', val as ZoneType)}
                >
                  <div>
                    <RadioGroupItem value="PRODUCT" id="t-prod" />
                    <Label htmlFor="t-prod">商品</Label>
                  </div>
                  <div>
                    <RadioGroupItem value="CATEGORY" id="t-cat" />
                    <Label htmlFor="t-cat">类目</Label>
                  </div>
                </RadioGroup>
              </div>
              <div>
                <Label>PC端列数</Label>
                <Input 
                  type="number" 
                  value={state.drawerFormData.pcCols} 
                  onChange={e => handlers.onDrawerFieldChange('pcCols', Number(e.target.value))} 
                />
              </div>
              <div>
                <Label>手机端列数</Label>
                <Input 
                  type="number" 
                  value={state.drawerFormData.mobileCols} 
                  onChange={e => handlers.onDrawerFieldChange('mobileCols', Number(e.target.value))} 
                />
              </div>
              <div>
                <Label>排序权重 (数值越大越靠前)</Label>
                <Input 
                  type="number" 
                  value={state.drawerFormData.sortWeight} 
                  onChange={e => handlers.onDrawerFieldChange('sortWeight', Number(e.target.value))} 
                />
              </div>
              <div>
                <Label>状态</Label>
                <Switch 
                  checked={state.drawerFormData.isActive} 
                  onCheckedChange={val => handlers.onDrawerFieldChange('isActive', val)} 
                />
              </div>

              {state.drawerFormData.zoneType === 'PRODUCT' && (
                <div>
                  <Label>集合名称</Label>
                  <Input 
                    value={state.drawerFormData.collectionName} 
                    onChange={e => handlers.onDrawerFieldChange('collectionName', e.target.value)}
                    placeholder="选填，保存时将创建集合" 
                  />
                  <p>填写名称后，保存时将自动创建永久商品集合并绑定；留空则仅作为首页临时自定义列表。</p>
                </div>
              )}

              <div>
                <div>
                  <Label>内容明细 ({state.drawerItems.length})</Label>
                  <Button onClick={handlers.onOpenSelector}>
                    + {state.drawerFormData.zoneType === 'PRODUCT' ? '选择商品' : '选择类目'}
                  </Button>
                </div>

                {state.drawerItems.length === 0 ? (
                  <p>暂无内容，请点击添加</p>
                ) : (
                  <Table>
                    <TableHeader>
                      <TableRow>
                        <TableHead>图片</TableHead>
                        <TableHead>名称</TableHead>
                        <TableHead>信息</TableHead>
                        <TableHead>操作</TableHead>
                      </TableRow>
                    </TableHeader>
                    <TableBody>
                      {state.drawerItems.map((item, index) => (
                        <TableRow 
                          key={`${item.entityId}-${index}`}
                          draggable
                          onDragStart={() => handlers.onDrawerItemDragStart(index)}
                          onDragEnter={() => handlers.onDrawerItemDragEnter(index)}
                          onDragEnd={() => handlers.onDrawerItemDragEnd()}
                          onDragOver={(e) => e.preventDefault()}
                        >
                          <TableCell>
                            {item.imageUrl ? <img src={item.imageUrl} alt={item.name} className="w-10 h-10 object-cover" /> : '无图'}
                          </TableCell>
                          <TableCell>{item.name}</TableCell>
                          <TableCell>{item.codeOrSku}</TableCell>
                          <TableCell>
                            <Button variant="ghost" onClick={() => handlers.onDrawerItemRemove(index)}>移除</Button>
                          </TableCell>
                        </TableRow>
                      ))}
                    </TableBody>
                  </Table>
                )}
              </div>
            </div>
          )}

          <SheetFooter>
            <Button variant="outline" onClick={() => handlers.onCloseDrawer(false)} disabled={state.drawerSaving}>取消</Button>
            <Button onClick={handlers.onDrawerSave} disabled={state.drawerSaving || state.drawerLoading}>保存配置</Button>
          </SheetFooter>
        </SheetContent>
      </Sheet>

      {/* 删除确认弹窗 */}
      <Dialog open={state.deleteOpen} onOpenChange={handlers.onCancelDelete}>
        <DialogContent>
          <DialogHeader>
            <DialogTitle>删除确认</DialogTitle>
            <DialogDescription>
              确定要删除该推荐专区吗？删除后首页对应的展示区块将被移除，此操作不可恢复。
            </DialogDescription>
          </DialogHeader>
          <DialogFooter>
            <Button variant="outline" onClick={() => handlers.onCancelDelete(false)} disabled={state.deleteLoading}>
              取消
            </Button>
            <Button variant="destructive" onClick={handlers.onConfirmDelete} disabled={state.deleteLoading}>
              确认删除
            </Button>
          </DialogFooter>
        </DialogContent>
      </Dialog>

      {/* 选择器弹窗 */}
      <Dialog open={state.selectorOpen} onOpenChange={handlers.onCloseSelector}>
        <DialogContent className="max-w-3xl">
          <DialogHeader>
            <DialogTitle>{state.drawerFormData.zoneType === 'PRODUCT' ? '选择推荐商品' : '选择推荐类目'}</DialogTitle>
          </DialogHeader>

          <div className="flex gap-2 mb-4">
            <Input
              placeholder="关键字搜索"
              value={state.modalKeyword}
              onChange={(e) => handlers.onModalKeywordChange(e.target.value)}
              onCompositionStart={() => (isComposingRef.current = true)}
              onCompositionEnd={() => { isComposingRef.current = false }}
              onKeyDown={(e) => {
                if (e.key === 'Enter' && !isComposingRef.current) {
                  handlers.onModalSearch()
                }
              }}
            />
            <Button onClick={handlers.onModalSearch} disabled={state.modalLoading}>搜索</Button>
            {state.drawerFormData.zoneType === 'PRODUCT' && (
              <Select value={state.modalCategoryIdFilter} onValueChange={handlers.onModalCategoryFilterChange}>
                <SelectTrigger className="w-[200px]">
                  <SelectValue placeholder="全部分类" />
                </SelectTrigger>
                <SelectContent>
                  <SelectItem value="all">全部分类</SelectItem>
                  {state.modalFilterCategories.map(c => (
                    <SelectItem key={c.id} value={c.id}>
                      {c.parentName ? `${c.parentName} - ` : ''}{c.name}
                    </SelectItem>
                  ))}
                </SelectContent>
              </Select>
            )}
          </div>

          <div className="max-h-[400px] overflow-y-auto">
            {state.modalLoading ? (
              <p>数据加载中...</p>
            ) : selectablePageItems.length === 0 && existingIdsInDrawer.length >= modalPageItems.length ? (
               <p>暂无可选数据或均已添加</p>
            ) : (
              <Table>
                <TableHeader>
                  <TableRow>
                    <TableHead>
                      <Checkbox
                        checked={isAllModalSelected}
                        onCheckedChange={(checked) => handlers.onModalToggleAll(!!checked)}
                      />
                    </TableHead>
                    <TableHead>缩略图</TableHead>
                    <TableHead>名称</TableHead>
                    <TableHead>{state.drawerFormData.zoneType === 'PRODUCT' ? '编码' : '层级'}</TableHead>
                  </TableRow>
                </TableHeader>
                <TableBody>
                  {modalPageItems.map(item => {
                    const isExisting = existingIdsInDrawer.includes(item.id)
                    const isSelected = state.modalSelectedItems.some(si => si.id === item.id)
                    const imageUrl = state.drawerFormData.zoneType === 'PRODUCT' ? (item as any).mainImageUrl : (item as any).imageUrl
                    const codeOrLevel = state.drawerFormData.zoneType === 'PRODUCT' ? (item as any).productCode : `层级 ${(item as any).level}`
                    
                    return (
                      <TableRow key={item.id}>
                        <TableCell>
                          <Checkbox
                            checked={isExisting || isSelected}
                            disabled={isExisting}
                            onCheckedChange={(checked) => handlers.onModalToggleSelect(item as any, !!checked)}
                          />
                        </TableCell>
                        <TableCell>
                          {imageUrl ? <img src={imageUrl} alt={item.name} className="w-10 h-10 object-cover" /> : <span>暂无图片</span>}
                        </TableCell>
                        <TableCell>{item.name}</TableCell>
                        <TableCell>{codeOrLevel}</TableCell>
                      </TableRow>
                    )
                  })}
                </TableBody>
              </Table>
            )}
          </div>

          <div className="flex justify-between items-center mt-4">
            {state.modalTotal > 0 && (
              <div className="flex items-center gap-2">
                <Button variant="outline" size="sm" disabled={state.modalPage <= 1} onClick={() => handlers.onModalPageChange(state.modalPage - 1)}>上一页</Button>
                <span>{state.modalPage} / {modalTotalPages}</span>
                <Button variant="outline" size="sm" disabled={state.modalPage >= modalTotalPages} onClick={() => handlers.onModalPageChange(state.modalPage + 1)}>下一页</Button>
              </div>
            )}
            <div className="flex gap-2">
              <span className="self-center mr-2">已选择 {state.modalSelectedItems.length} 项</span>
              <Button variant="outline" onClick={() => handlers.onCloseSelector(false)}>取消</Button>
              <Button onClick={handlers.onModalConfirm} disabled={state.modalSelectedItems.length === 0}>确认添加</Button>
            </div>
          </div>
        </DialogContent>
      </Dialog>
    </div>
  )
}