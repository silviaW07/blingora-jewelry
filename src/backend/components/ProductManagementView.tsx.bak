'use client'
import React from 'react'
import type { ProductStatus, ProductSource, StockStatus } from '@/backend/actions/ProductManagement'
import {
  Button,
  Input,
  Select,
  SelectTrigger,
  SelectValue,
  SelectContent,
  SelectItem,
  Table,
  TableHeader,
  TableRow,
  TableHead,
  TableBody,
  TableCell,
  Checkbox,
  Sheet,
  SheetContent,
  SheetHeader,
  SheetTitle,
  Dialog,
  DialogContent,
  DialogHeader,
  DialogTitle,
  DialogFooter,
  DialogDescription,
  Textarea
} from '@/backend/components/ui'
import type { ProductManagementState, ProductManagementHandlers } from '@/backend/hooks/useProductManagement'

// ===== 枚举映射 =====
const STATUS_LABELS: Record<ProductStatus, string> = {
  DRAFT: '草稿',
  ACTIVE: '已上架',
  INACTIVE: '已下架',
};

const SOURCE_LABELS: Record<ProductSource, string> = {
  MANUAL: '手动创建',
  IMPORT_1688: '1688导入',
};

interface Props {
  state: ProductManagementState
  handlers: ProductManagementHandlers
}

export const ProductManagementView = ({ state, handlers }: Props) => {
  const hasSelected = state.selectedIds.length > 0;

  return (
    <div>
      {/* 头部工具栏 */}
      <section className="flex gap-4 mb-4 items-end flex-wrap">
        <div>
          <label className="text-sm block mb-1">商品名称</label>
          <Input 
            placeholder="搜索商品名称..." 
            value={state.filterKeyword} 
            onChange={e => handlers.setFilterKeyword(e.target.value)} 
          />
        </div>
        <div>
          <label className="text-sm block mb-1">分类</label>
          <Select value={state.filterCategoryId} onValueChange={handlers.setFilterCategoryId}>
            <SelectTrigger className="w-[180px]">
              <SelectValue placeholder="全部分类" />
            </SelectTrigger>
            <SelectContent>
              <SelectItem value="ALL">全部分类</SelectItem>
              {state.categoryOptions.map(c => (
                <SelectItem key={c.category_id} value={c.category_id}>{c.category_name}</SelectItem>
              ))}
            </SelectContent>
          </Select>
        </div>
        <div>
          <label className="text-sm block mb-1">状态</label>
          <Select value={state.filterStatus} onValueChange={handlers.setFilterStatus}>
            <SelectTrigger className="w-[120px]">
              <SelectValue placeholder="全部状态" />
            </SelectTrigger>
            <SelectContent>
              <SelectItem value="ALL">全部状态</SelectItem>
              <SelectItem value="DRAFT">草稿</SelectItem>
              <SelectItem value="ACTIVE">已上架</SelectItem>
              <SelectItem value="INACTIVE">已下架</SelectItem>
            </SelectContent>
          </Select>
        </div>
        <div className="flex gap-2">
          <Button variant="secondary" onClick={handlers.handleReset}>重置</Button>
          <Button onClick={handlers.handleSearch}>查询</Button>
        </div>
        <div className="ml-auto">
          <Button onClick={handlers.handleOpenCreate}>新增商品</Button>
        </div>
      </section>

      <hr className="my-4" />

      {/* 批量操作区 */}
      <section className="flex gap-2 mb-4">
        <Button 
          disabled={!hasSelected} 
          onClick={() => handlers.openConfirmDialog('ACTIVE', state.selectedIds)}
        >
          批量上架
        </Button>
        <Button 
          disabled={!hasSelected} 
          onClick={() => handlers.openConfirmDialog('INACTIVE', state.selectedIds)}
        >
          批量下架
        </Button>
        <Button 
          variant="destructive" 
          disabled={!hasSelected} 
          onClick={() => handlers.openConfirmDialog('DELETE', state.selectedIds)}
        >
          批量删除
        </Button>
      </section>

      {/* 数据表格区 */}
      <section>
        <Table>
          <TableHeader>
            <TableRow>
              <TableHead className="w-[50px]">
                <Checkbox 
                  checked={state.list.length > 0 && state.selectedIds.length === state.list.length}
                  onCheckedChange={(checked) => handlers.handleSelectAll(!!checked)}
                />
              </TableHead>
              <TableHead>商品名称/SKU基础编码</TableHead>
              <TableHead>来源</TableHead>
              <TableHead>分类</TableHead>
              <TableHead>价格区间</TableHead>
              <TableHead>总库存</TableHead>
              <TableHead>状态</TableHead>
              <TableHead>创建时间</TableHead>
              <TableHead className="text-right">操作</TableHead>
            </TableRow>
          </TableHeader>
          <TableBody>
            {state.loading ? (
              <TableRow><TableCell colSpan={9} className="text-center py-8">数据加载中...</TableCell></TableRow>
            ) : state.list.length === 0 ? (
              <TableRow><TableCell colSpan={9} className="text-center py-8">暂无数据</TableCell></TableRow>
            ) : (
              state.list.map(item => (
                <TableRow key={item.product_id}>
                  <TableCell>
                    <Checkbox 
                      checked={state.selectedIds.includes(item.product_id)}
                      onCheckedChange={(checked: boolean) => handlers.handleSelectRow(item.product_id, checked)}
                    />
                  </TableCell>
                  <TableCell>
                    <div className="font-medium">{item.product_name}</div>
                    <div className="text-xs text-muted-foreground">{item.sku_code_base}</div>
                  </TableCell>
                  <TableCell>{SOURCE_LABELS[item.source]}</TableCell>
                  <TableCell>{item.category_name}</TableCell>
                  <TableCell>{item.price_min} - {item.price_max}</TableCell>
                  <TableCell>{item.total_stock}</TableCell>
                  <TableCell>{STATUS_LABELS[item.status]}</TableCell>
                  <TableCell className="text-xs text-muted-foreground">{new Date(item.created_at).toLocaleString()}</TableCell>
                  <TableCell className="text-right flex gap-1 justify-end">
                    <Button variant="outline" size="sm" onClick={() => handlers.handleOpenEdit(item.product_id)}>编辑</Button>
                    {item.status === 'ACTIVE' ? (
                      <Button variant="outline" size="sm" onClick={() => handlers.openConfirmDialog('INACTIVE', [item.product_id])}>下架</Button>
                    ) : (
                      <Button variant="outline" size="sm" onClick={() => handlers.openConfirmDialog('ACTIVE', [item.product_id])}>上架</Button>
                    )}
                    <Button variant="destructive" size="sm" onClick={() => handlers.openConfirmDialog('DELETE', [item.product_id])}>删除</Button>
                  </TableCell>
                </TableRow>
              ))
            )}
          </TableBody>
        </Table>

        <div className="flex items-center justify-between mt-4">
          <span className="text-sm text-muted-foreground">共 {state.total} 条</span>
          <div className="flex items-center gap-2">
            <Button 
              variant="outline"
              size="sm"
              disabled={state.currentPage <= 1 || state.loading} 
              onClick={() => handlers.setCurrentPage(state.currentPage - 1)}
            >
              上一页
            </Button>
            <span className="text-sm">第 {state.currentPage} 页</span>
            <Button 
              variant="outline"
              size="sm"
              disabled={state.currentPage * state.pageSize >= state.total || state.loading} 
              onClick={() => handlers.setCurrentPage(state.currentPage + 1)}
            >
              下一页
            </Button>
          </div>
        </div>
      </section>

      {/* 商品编辑抽屉 */}
      <Sheet open={state.drawerOpen} onOpenChange={handlers.setDrawerOpen}>
        <SheetContent className="w-[800px] sm:max-w-[800px] overflow-y-auto">
          <SheetHeader>
            <SheetTitle>
              {state.drawerMode === 'create' ? '新增商品' : '编辑商品'} 
            </SheetTitle>
          </SheetHeader>

          {state.drawerLoading ? (
            <div className="py-10 text-center">加载中...</div>
          ) : (
            <div className="space-y-6 mt-4 pb-20">
              <fieldset className="border p-4 rounded-md space-y-4">
                <legend className="px-2 font-bold">基础信息</legend>
                <div>
                  <label className="text-sm font-medium">商品名称</label>
                  <Input 
                    value={state.formData.name} 
                    onChange={e => handlers.handleFormFieldChange('name', e.target.value)} 
                    placeholder="请输入商品名称" 
                  />
                </div>
                <div>
                  <label className="text-sm font-medium">所属分类</label>
                  <Select value={state.formData.category_id} onValueChange={v => handlers.handleFormFieldChange('category_id', v)}>
                    <SelectTrigger><SelectValue placeholder="请选择分类" /></SelectTrigger>
                    <SelectContent>
                      {state.categoryOptions.map(c => (
                        <SelectItem key={c.category_id} value={c.category_id}>{c.category_name}</SelectItem>
                      ))}
                    </SelectContent>
                  </Select>
                </div>
                <div>
                  <label className="text-sm font-medium">摘要卖点</label>
                  <Textarea 
                    value={state.formData.short_description || ''} 
                    onChange={e => handlers.handleFormFieldChange('short_description', e.target.value)}
                  />
                </div>
              </fieldset>

              <fieldset className="border p-4 rounded-md space-y-4">
                <legend className="px-2 font-bold">媒体资源</legend>
                <div>
                  <label className="text-sm font-medium">主图 URL</label>
                  <Input 
                    value={state.formData.main_image_url} 
                    onChange={e => handlers.handleFormFieldChange('main_image_url', e.target.value)} 
                  />
                </div>
                <div className="space-y-2">
                  <label className="text-sm font-medium">相册</label>
                  {state.formData.gallery_json?.map((img, idx) => (
                    <div key={idx} className="flex gap-2">
                      <Input value={img.url} onChange={e => handlers.updateGalleryItem(idx, e.target.value)} />
                      <Button variant="destructive" size="sm" onClick={() => handlers.removeGalleryItem(idx)}>移除</Button>
                    </div>
                  ))}
                  <Button variant="outline" className="w-full" onClick={handlers.addGalleryItem}>+ 添加图片</Button>
                </div>
              </fieldset>

              <fieldset className="border p-4 rounded-md space-y-4">
                <legend className="px-2 font-bold">SKU 规格配置</legend>
                <div className="space-y-2">
                  {state.specDimensions.map((dim, idx) => (
                    <div key={idx} className="flex gap-2 border p-2 rounded">
                      <Input placeholder="颜色" value={dim.name} onChange={e => handlers.updateSpecDimension(idx, 'name', e.target.value)} />
                      <Input placeholder="红,蓝" value={dim.values} onChange={e => handlers.updateSpecDimension(idx, 'values', e.target.value)} />
                      <Button variant="ghost" onClick={() => handlers.removeSpecDimension(idx)}>删除</Button>
                    </div>
                  ))}
                  <div className="flex gap-2">
                    <Button variant="outline" onClick={handlers.addSpecDimension}>添加维度</Button>
                    <Button onClick={handlers.generateSkus}>生成 SKU</Button>
                  </div>
                </div>
                {state.formData.skus.length > 0 && (
                  <Table>
                    <TableHeader>
                      <TableRow>
                        <TableHead>规格</TableHead>
                        <TableHead>售价</TableHead>
                        <TableHead>库存</TableHead>
                      </TableRow>
                    </TableHeader>
                    <TableBody>
                      {state.formData.skus.map((sku, idx) => (
                        <TableRow key={idx}>
                          <TableCell className="text-xs">
                            {sku.attribute_json?.map(a => a.value).join('/')}
                          </TableCell>
                          <TableCell>
                            <Input type="number" className="h-8" value={sku.price} onChange={e => handlers.updateSkuRow(idx, 'price', Number(e.target.value))} />
                          </TableCell>
                          <TableCell>
                            <Input type="number" className="h-8" value={sku.stock} onChange={e => handlers.updateSkuRow(idx, 'stock', Number(e.target.value))} />
                          </TableCell>
                        </TableRow>
                      ))}
                    </TableBody>
                  </Table>
                )}
              </fieldset>

              <div className="fixed bottom-0 right-0 left-0 bg-background border-t p-4 flex justify-end gap-2">
                <Button variant="outline" disabled={state.saving} onClick={() => handlers.handleSubmitForm('DRAFT')}>保存为草稿</Button>
                <Button disabled={state.saving} onClick={() => handlers.handleSubmitForm('ACTIVE')}>
                  {state.drawerMode === 'create' ? '提交并上架' : '更新并上架'}
                </Button>
              </div>
            </div>
          )}
        </SheetContent>
      </Sheet>

      {/* 确认弹窗 */}
      <Dialog open={state.confirmDialogOpen} onOpenChange={handlers.setConfirmDialogOpen}>
        <DialogContent>
          <DialogHeader>
            <DialogTitle>确认操作</DialogTitle>
            <DialogDescription>
              {state.confirmAction === 'ACTIVE' && '确认上架选定商品？'}
              {state.confirmAction === 'INACTIVE' && '确认下架选定商品？'}
              {state.confirmAction === 'DELETE' && '确认删除选定商品？此操作不可撤销。'}
            </DialogDescription>
          </DialogHeader>
          <DialogFooter>
            <Button variant="outline" onClick={() => handlers.setConfirmDialogOpen(false)}>取消</Button>
            <Button 
              variant={state.confirmAction === 'DELETE' ? 'destructive' : 'default'}
              onClick={handlers.handleConfirmAction}
              disabled={state.confirmLoading}
            >
              {state.confirmLoading ? '执行中...' : '确认'}
            </Button>
          </DialogFooter>
        </DialogContent>
      </Dialog>
    </div>
  )
}