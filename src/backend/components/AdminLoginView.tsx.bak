'use client'
import React from 'react';
import { Input } from '@/components/ui/input';
import { Button } from '@/components/ui/button';
import { Label } from '@/components/ui/label';
import type { AdminLoginState, AdminLoginHandlers } from '@/backend/hooks/useAdminLogin';

interface Props {
  state: AdminLoginState;
  handlers: AdminLoginHandlers;
}

export const AdminLoginView = ({ state, handlers }: Props) => {
  return (
    <main>
      <div>
        {/* 左侧：系统信息与声明栏 */}
        <section>
          <div>
            <h1>外贸跨境电商独立站管理系统</h1>
          </div>
          <div>
            <p>全球供应链与1688商品路由中枢</p>
          </div>
          <div>
            <p>受控环境：仅限后台管理员进入，验证通过后将跳转至管理概览调度台</p>
          </div>
          <div>
            {/* 视觉锚点：拓扑图占位 */}
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              strokeWidth="2"
              strokeLinecap="round"
              strokeLinejoin="round"
            >
              <polygon points="12 2 2 7 12 12 22 7 12 2" />
              <polyline points="2 17 12 22 22 17" />
              <polyline points="2 12 12 17 22 12" />
            </svg>
          </div>
        </section>

        {/* 右侧：身份验证执行栏 */}
        <section>
          <header>
            <h2>管理员登录</h2>
            <p>系统控制台安全入口</p>
          </header>

          <form onSubmit={handlers.handleSubmit}>
            <div>
              <Label htmlFor="account">账号</Label>
              <Input
                id="account"
                type="text"
                placeholder="请输入管理员账号"
                value={state.formData.sysuser_account}
                onChange={(e) => handlers.handleFormFieldChange('sysuser_account', e.target.value)}
                disabled={state.isSubmitting}
              />
            </div>

            <div>
              <Label htmlFor="password">密码</Label>
              <Input
                id="password"
                type="password"
                placeholder="请输入密码"
                value={state.formData.sysuser_password}
                onChange={(e) => handlers.handleFormFieldChange('sysuser_password', e.target.value)}
                disabled={state.isSubmitting}
              />
            </div>

            <div>
              <Button type="submit" disabled={state.isSubmitting}>
                {state.isSubmitting ? '验证中...' : '登录系统'}
              </Button>
            </div>
          </form>

          <footer>
            <span>内部管理账号获取？</span>
            <Button variant="link" onClick={handlers.handleGoToRegister} disabled={state.isSubmitting}>
              前往注册
            </Button>
          </footer>
        </section>
      </div>
    </main>
  );
};