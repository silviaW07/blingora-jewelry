'use client'

import React from 'react';
import type { UserManagementState, UserManagementHandlers } from '@/backend/hooks/useUserManagement';
import {
  Table,
  TableBody,
  TableCell,
  TableHead,
  TableHeader,
  TableRow,
} from '@/components/ui/table';
import { Button } from '@/components/ui/button';
import { Input } from '@/components/ui/input';
import {
  Select,
  SelectContent,
  SelectItem,
  SelectTrigger,
  SelectValue,
} from '@/components/ui/select';
import {
  Sheet,
  SheetContent,
  SheetHeader,
  SheetTitle,
} from '@/components/ui/sheet';
import {
  AlertDialog,
  AlertDialogAction,
  AlertDialogCancel,
  AlertDialogContent,
  AlertDialogDescription,
  AlertDialogFooter,
  AlertDialogHeader,
  AlertDialogTitle,
} from '@/components/ui/alert-dialog';
import { Switch } from '@/components/ui/switch';

interface Props {
  state: UserManagementState;
  handlers: UserManagementHandlers;
}

export const UserManagementView = ({ state, handlers }: Props) => {
  return (
    <div>
      <header>
        <h2>用户管理</h2>
        <p>当前系统共检索到 {state.total} 名用户</p>
      </header>

      <section>
        <div className="flex gap-4 mb-4">
          <Input
            placeholder="账户名搜索..."
            value={state.localFilters.account}
            onChange={(e) => handlers.handleTextChange('account', e.target.value)}
            onCompositionStart={handlers.handleCompositionStart}
            onCompositionEnd={() => handlers.handleCompositionEnd('account')}
          />
          <Input
            placeholder="邮箱地址搜索..."
            value={state.localFilters.email}
            onChange={(e) => handlers.handleTextChange('email', e.target.value)}
            onCompositionStart={handlers.handleCompositionStart}
            onCompositionEnd={() => handlers.handleCompositionEnd('email')}
          />
          <Select value={state.urlParams.role || 'ALL'} onValueChange={(val) => handlers.handleSelectChange('role', val)}>
            <SelectTrigger>
              <SelectValue placeholder="所有角色" />
            </SelectTrigger>
            <SelectContent>
              <SelectItem value="ALL">全部角色</SelectItem>
              <SelectItem value="CUSTOMER">{state.ROLE_LABELS['CUSTOMER']}</SelectItem>
              <SelectItem value="ADMIN">{state.ROLE_LABELS['ADMIN']}</SelectItem>
            </SelectContent>
          </Select>
          <Select value={state.urlParams.status || 'ALL'} onValueChange={(val) => handlers.handleSelectChange('status', val)}>
            <SelectTrigger>
              <SelectValue placeholder="所有状态" />
            </SelectTrigger>
            <SelectContent>
              <SelectItem value="ALL">全部状态</SelectItem>
              <SelectItem value="ACTIVE">{state.STATUS_LABELS['ACTIVE']}</SelectItem>
              <SelectItem value="DISABLED">{state.STATUS_LABELS['DISABLED']}</SelectItem>
            </SelectContent>
          </Select>
          <Button variant="outline" onClick={handlers.handleResetFilters}>
            重置条件
          </Button>
        </div>
      </section>

      <section>
        <Table>
          <TableHeader>
            <TableRow>
              <TableHead>账户名</TableHead>
              <TableHead>邮箱</TableHead>
              <TableHead>角色</TableHead>
              <TableHead>注册时间</TableHead>
              <TableHead>购物车商品数</TableHead>
              <TableHead>状态</TableHead>
              <TableHead>操作</TableHead>
            </TableRow>
          </TableHeader>
          <TableBody>
            {state.loading ? (
              <TableRow>
                <TableCell colSpan={7}>数据加载中...</TableCell>
              </TableRow>
            ) : state.list.length === 0 ? (
              <TableRow>
                <TableCell colSpan={7}>暂无符合条件的用户</TableCell>
              </TableRow>
            ) : (
              state.list.map((user) => (
                <TableRow key={user.id}>
                  <TableCell>{user.account}</TableCell>
                  <TableCell>{user.email}</TableCell>
                  <TableCell>{state.ROLE_LABELS[user.role]}</TableCell>
                  <TableCell>{handlers.formatDateTime(user.createdAt)}</TableCell>
                  <TableCell>{user.cartItemCount}</TableCell>
                  <TableCell>
                    {state.STATUS_LABELS[user.status]}
                  </TableCell>
                  <TableCell>
                    <Button variant="ghost" onClick={() => handlers.handleOpenDetail(user.id)}>详情</Button>
                    <Button
                      variant="ghost"
                      onClick={() => handlers.handleToggleStatus(user.id, user.status, 'list')}
                    >
                      {user.status === 'ACTIVE' ? '禁用' : '启用'}
                    </Button>
                    <Button
                      variant="destructive"
                      onClick={() => handlers.handleRequestDelete(user)}
                    >
                      删除
                    </Button>
                  </TableCell>
                </TableRow>
              ))
            )}
          </TableBody>
        </Table>

        {/* 分页器 */}
        {!state.loading && state.total > 0 && (
          <div className="flex items-center gap-4 mt-4">
            <span>共 {state.total} 条数据，当前 {state.page} / {state.totalPages} 页</span>
            <Button
              variant="outline"
              disabled={state.page <= 1}
              onClick={() => handlers.handlePageChange(state.page - 1)}
            >
              上一页
            </Button>
            <Button
              variant="outline"
              disabled={state.page >= state.totalPages}
              onClick={() => handlers.handlePageChange(state.page + 1)}
            >
              下一页
            </Button>
          </div>
        )}
      </section>

      {/* 详情侧边抽屉 */}
      <Sheet open={state.detailSheetOpen} onOpenChange={handlers.setDetailSheetOpen}>
        <SheetContent>
          <SheetHeader>
            <SheetTitle>用户详情</SheetTitle>
          </SheetHeader>
          <div className="mt-4">
            {state.detailLoading ? (
              <p>加载中...</p>
            ) : state.detailData ? (
              <div className="space-y-6">
                <section>
                  <h3 className="font-bold mb-2">基础信息</h3>
                  <p>用户 ID: {state.detailData.id}</p>
                  <p>账户名: {state.detailData.account}</p>
                  <p>邮箱: {state.detailData.email}</p>
                  <p>角色: {state.ROLE_LABELS[state.detailData.role]}</p>
                  <p>注册时间: {handlers.formatDateTime(state.detailData.createdAt)}</p>
                </section>
                <section>
                  <h3 className="font-bold mb-2">安全与活动</h3>
                  <p>最近登录时间: {handlers.formatDateTime(state.detailData.lastLoginAt)}</p>
                </section>
                <section>
                  <h3 className="font-bold mb-2">业务摘要</h3>
                  <p>购物车 ID: {state.detailData.cartId || '暂无'}</p>
                  <p>购物车商品总数: {state.detailData.cartItemCount}</p>
                </section>
                <section>
                  <h3 className="font-bold mb-2">状态管理</h3>
                  <p>当前状态: {state.STATUS_LABELS[state.detailData.status]}</p>
                  <div className="mt-2 flex items-center gap-2">
                    <label className="text-sm">切换状态 (禁用后对登录及购物车使用产生影响)</label>
                    <Switch
                      checked={state.detailData.status === 'ACTIVE'}
                      onCheckedChange={() => handlers.handleToggleStatus(state.detailData!.id, state.detailData!.status, 'detail')}
                    />
                  </div>
                </section>
              </div>
            ) : (
              <p>未找到数据</p>
            )}
          </div>
        </SheetContent>
      </Sheet>

      {/* 风险操作确认弹窗 */}
      <AlertDialog open={state.deleteDialogOpen} onOpenChange={handlers.setDeleteDialogOpen}>
        <AlertDialogContent>
          <AlertDialogHeader>
            <AlertDialogTitle>确认删除用户</AlertDialogTitle>
            <AlertDialogDescription>
              警告：确定要删除账户 [{state.userToDelete?.account}] ({state.userToDelete?.email}) 吗？
              这将清空该用户购物车数据并永久移除账号记录。该操作无法撤销。
            </AlertDialogDescription>
          </AlertDialogHeader>
          <AlertDialogFooter>
            <AlertDialogCancel disabled={state.actionLoading}>取消</AlertDialogCancel>
            <AlertDialogAction disabled={state.actionLoading} onClick={handlers.handleConfirmDelete}>
              确认删除
            </AlertDialogAction>
          </AlertDialogFooter>
        </AlertDialogContent>
      </AlertDialog>
    </div>
  );
};